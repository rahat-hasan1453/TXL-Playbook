generator client {
  provider = "prisma-client-js"
}

# Specify the database connection string in your environment
# Or use a .env file placed at the root of your project
# Example: DATABASE_URL="postgresql://user:pass@localhost:5432/dbname"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String            @id @default(uuid())
  name      String
  email     String            @unique
  role      Role              @default(LEARNER)
  avatar    String?           // URL to user avatar
  notes     UserNote[]
  progress  UserProgress[]
  shared    SharedLearning[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Domain {
  id    String   @id @default(uuid())
  name  String   @unique
  topics Topic[]
}

model Topic {
  id          String          @id @default(uuid())
  domain      Domain          @relation(fields: [domainId], references: [id])
  domainId    String
  title       String
  description String
  level       Int             // e.g. 1-3
  order       Int             // sort order within domain
  notes       UserNote[]
  progress    UserProgress[]
}

model UserProgress {
  id         String          @id @default(uuid())
  user       User            @relation(fields: [userId], references: [id])
  userId     String
  topic      Topic           @relation(fields: [topicId], references: [id])
  topicId    String
  status     ProgressStatus  @default(NOT_STARTED)
  completedAt DateTime?
  updatedAt  DateTime        @updatedAt

  @@unique([userId, topicId])
}

model UserNote {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  topic     Topic    @relation(fields: [topicId], references: [id])
  topicId   String
  content   String   // Markdown
  updatedAt DateTime @updatedAt

  @@unique([userId, topicId])
}

model SharedLearning {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  topic     Topic    @relation(fields: [topicId], references: [id])
  topicId   String
  content   String
  createdAt DateTime @default(now())
  // Future: likes/comments etc.
}

enum Role {
  LEARNER
  UNIT_HEAD
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
