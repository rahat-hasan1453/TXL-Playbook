# Learning plan reminders
# Public URL the reminder email links point to
APP_BASE_URL=http://localhost:3000
# Signs the one-click links in reminder emails (required in production; any long random string)
REMINDER_LINK_SECRET=
# Lets an external cron call POST /api/reminders/run with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# "send" (default) sends through Blocks Mail via the blocks CLI; "log" only writes .data/reminder-outbox.json
REMINDER_MAIL_MODE=send
# Set to "off" to disable the built-in once-a-minute reminder scheduler
REMINDER_SCHEDULER=on
